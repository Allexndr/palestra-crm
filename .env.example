ы# =============================================================================
# Palestra — environment variables
# Copy to `.env` locally. Never commit real secrets. Rotate any leaked keys.
# =============================================================================
#
# —— Client (Vite) — only variables prefixed with VITE_ are exposed to the
#     browser. Do not put service role keys, Blob tokens, or DB passwords in VITE_*.
# —— Server (Vercel API routes / local `vercel dev`) — all other variables are
#     read only on the server via process.env.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase — public (safe in the frontend bundle if you add a client later)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://xxxxx.supabase.co
VITE_SUPABASE_URL=

# anon / publishable key (not the service role)
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — server-only (Vercel → Project → Settings → Environment Variables)
# ---------------------------------------------------------------------------
# Same URL as VITE_… if you prefer a single var on the server; api/_lib uses
# SUPABASE_URL or falls back to VITE_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role: full DB access. Required for registration, app_state sync, and
# admin user creation. Must NEVER be in VITE_* or client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: if you add Edge Functions that verify JWTs outside Supabase helpers.
# Not required for the current Vercel API (session tokens are in HttpOnly cookies).
# SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Vercel Blob — server-only
# ---------------------------------------------------------------------------
# From Vercel dashboard → your Blob store → .env / token (read/write).
# Used by /api/blob/upload and /api/blob/delete.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# AI Assistant (Gemini Flash) — server-only
# ---------------------------------------------------------------------------
# Get free API key: https://aistudio.google.com/app/apikey
# Free tier: 1 500 req/day, 1M tokens/day — sufficient for in-app help chat.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Auth / demo
# ---------------------------------------------------------------------------
# When "false", only real Supabase Auth sign-in is allowed (no cookie demo users).
# Use "true" in local dev if Supabase is not configured.
ALLOW_DEMO_AUTH=true

# ---------------------------------------------------------------------------
# Media limits (enforced in api/_lib/media.js; no env required)
# ---------------------------------------------------------------------------
# Images: up to ~12 MB before optimization; other allowed types up to 30 MB.
